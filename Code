def get_prediction_info(model, vectorizer, text):
    cleaned = clean_text(text)
    vector = vectorizer.transform([cleaned])
    probability = model.predict_proba(vector)[0]
    prediction_code = int(model.predict(vector)[0])
    confidence = probability[prediction_code]
    label = "REAL NEWS" if prediction_code == 1 else "FAKE NEWS"
    return label, float(confidence)


if __name__ == "__main__":
    dataset = Path("news.csv")
    if not dataset.exists():
        raise FileNotFoundError("news.csv not found in the current folder.")

    df = load_and_prepare_data(dataset)
    model, vectorizer = train_model(df)

    if len(sys.argv) > 1:
        user_text = " ".join(sys.argv[1:])
        label, confidence = get_prediction_info(model, vectorizer, user_text)
        print(f"Prediction: {label} | Confidence: {confidence:.2%}")
    else:
        print("Type a news article or 'exit' to quit.")
        while True:
            text = input("News text: ")
            if text.lower() == "exit":
                break
            label, confidence = get_prediction_info(model, vectorizer, text)
            print(f"Prediction: {label} | Confidence: {confidence:.2%}")
    
