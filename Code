from pathlib import Path

from detector import DATASET_PATH, load_and_prepare_data, predict_news, train_model


def main():
    if not DATASET_PATH.exists():
        raise FileNotFoundError(
            f"Dataset not found: {DATASET_PATH}. Add news.csv with text and label columns."
        )

    df = load_and_prepare_data(DATASET_PATH)
    model, vectorizer, metrics = train_model(df)
    print(f"Accuracy: {metrics['accuracy']:.2%}")
    print(metrics["report"])
    print("Type an article, or type 'exit' to quit.")

    while True:
        text = input("News text: ").strip()
        if text.lower() == "exit":
            break
        if not text:
            print("Please enter some text.")
            continue
        result = predict_news(model, vectorizer, text)
        print(f"Prediction: {result['label']} | Confidence: {result['confidence']:.2%}\n")


if __name__ == "__main__":
    main()
